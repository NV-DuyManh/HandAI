# AI Service Configuration
APP_ENV=development
RUNTIME_MODE=FIXTURE

# Server
PORT=8000
HOST=0.0.0.0

# Redis
REDIS_URL=redis://localhost:6379/0

# Callback
SPRING_CALLBACK_BASE_URL=http://localhost:8080/internal/v1/ai/jobs
INTERNAL_API_KEY=secret-key-default

# Model
MODEL_MANIFEST_PATH=
MODEL_ARTIFACT_PATH=

# Object Storage (MinIO S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=mathvision
MINIO_SECURE=false

# Groq Vision Integration
# ALL keys in ONE comma-separated variable. No numbered variables.
# Example: GROQ_API_KEYS="gsk_keyA,gsk_keyB,gsk_keyC"
GROQ_ENABLED=false
GROQ_API_KEYS=""

GROQ_PRIMARY_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_VISION_MODEL=qwen/qwen3.6-27b

# Canonical runtime override (demoted from production default in GROQ.5)
CANONICAL_RUNTIME_OVERRIDE_ENABLED=false

GROQ_LINE_ASSIST_MODE=suspicious_only
GROQ_CONSENSUS_MODE=adaptive

# Groq Post-Correction (Role B)
GROQ_POST_CORRECTION_ENABLED=true
GROQ_POST_CORRECTION_TRIGGER_CONFIDENCE=0.82
GROQ_POST_CORRECTION_AUTO_APPLY_CONFIDENCE=0.92
GROQ_POST_CORRECTION_MAX_EDIT_RATIO=0.35
GROQ_OCR_CORRECTION_PROMPT_VERSION=groq-ocr-correction-v1
GROQ_CORRECTION_CACHE_TTL_SECONDS=3600


GROQ_ACCEPT_CONFIDENCE_THRESHOLD=0.80
GROQ_SECOND_PASS_CONFIDENCE_THRESHOLD=0.82

GROQ_TIMEOUT_SECONDS=25
GROQ_CONNECT_TIMEOUT_SECONDS=8
GROQ_MAX_REQUEST_ATTEMPTS=3

GROQ_RETRY_BASE_MS=400
GROQ_RETRY_MAX_MS=4000

GROQ_KEY_COOLDOWN_SECONDS=60
GROQ_AUTH_DISABLE_SECONDS=1800

GROQ_ROTATE_ON_429=false

GROQ_MAX_LONG_EDGE=2200
GROQ_JPEG_QUALITY=92
GROQ_CACHE_TTL_SECONDS=300

# Physical Android Trace & Observability (Development mode only; default false)
OCR_PHYSICAL_TRACE_ENABLED=false

# -------------------------------------------------------------------
# GEMINI MULTI-KEY POOL (2nd Advisor Integration)
# Paste your Gemini keys below, comma-separated.
# Duplicates will be automatically removed at runtime.
# Never commit this file.
# -------------------------------------------------------------------
# ALL keys in ONE comma-separated variable. No numbered variables.
# Example: GEMINI_API_KEYS="key1,key2,key3,key4"
GEMINI_ENABLED=true
GEMINI_API_KEYS="PASTE_KEY_1_HERE,PASTE_KEY_2_HERE,PASTE_KEY_3_HERE,PASTE_KEY_4_HERE"
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_ENABLED=false
GEMINI_POST_CORRECTION_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15
GEMINI_CONNECT_TIMEOUT_SECONDS=4
GEMINI_ROTATE_ON_429=false
GEMINI_KEY_COOLDOWN_SECONDS=300
# 0 = try each unique key at most once per request; >0 = cap total unique key attempts
GEMINI_MAX_KEY_ATTEMPTS_PER_REQUEST=3
GEMINI_CORRECTION_PROMPT_VERSION=gemini-ocr-correction-v1
GEMINI_CORRECTION_CACHE_TTL_SECONDS=3600

# -------------------------------------------------------------------
# CLOUD ADVISOR CONCURRENCY (PROD.2G)
# Bounded concurrency for triggered lines advisor execution
# -------------------------------------------------------------------
CLOUD_ADVISOR_MAX_CONCURRENCY=3


