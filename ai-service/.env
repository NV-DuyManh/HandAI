# HandAI Standalone AI Microservice Configuration
HOST=127.0.0.1
PORT=8001
APP_ENV=development
RUNTIME_MODE=LIVE

# Security
INTERNAL_API_KEY=secret-key-default

# OCR Model Configuration
OCR_PROVIDER=crnn_vi_handwriting_v1
OCR_MODEL_DIR=models/ocr/crnn_vi_handwriting_v1
OCR_DEVICE=cpu

# LLM Post-Correction (Optional: Fill in your keys if using Groq / Gemini)
GROQ_ENABLED=true
GROQ_API_KEYS=
GROQ_PRIMARY_VISION_MODEL=qwen/qwen3.8-27b
GROQ_POST_CORRECTION_ENABLED=true

GEMINI_ENABLED=true
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_POST_CORRECTION_ENABLED=true

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET=ocr-trials
